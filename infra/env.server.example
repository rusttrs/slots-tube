# slots.tube — шаблон .env ДЛЯ СЕРВЕРА (локальная разработка — корневой .env.example).
# Описание каждой переменной и где брать значения: docs/env.md
# Пустые значения с пометкой SECRET — заполнить. APP_KEY и DB_PASSWORD provision.sh сгенерирует сам,
# но при переезде лучше перенести старый APP_KEY (иначе разлогинит всех и сломает remember-me).

APP_NAME="slots.tube"
APP_ENV=staging
# SECRET
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.slots.tube

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=slotstube
DB_USERNAME=slotstube
# SECRET
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

TRUSTED_PROXIES=*

# Почта — Resend (домен slots.tube верифицирован в Resend)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@slots.tube"
MAIL_FROM_NAME="${APP_NAME}"
# SECRET (Resend → API Keys). Laravel читает RESEND_KEY, при его отсутствии — RESEND_API_KEY
RESEND_KEY=
RESEND_API_KEY=

# Медиа — Cloudflare R2, бакет slots-tube-media (S3-совместимый API)
# SECRET (Cloudflare → R2 → Manage R2 API tokens)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=slots-tube-media
AWS_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Вход через Google (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client)
GOOGLE_CLIENT_ID=
# SECRET
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.slots.tube/auth/google/callback

VITE_APP_NAME="${APP_NAME}"
